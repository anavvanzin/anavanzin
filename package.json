{
  "name": "iconocracia",
  "version": "1.0.0",
  "description": "Iconocracia E2E Tests",
  "main": "index.html",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "stage:assets": "bash scripts/stage-worker-assets.sh",
    "build:pages": "node scripts/pages/build.mjs",
    "test:pages": "node --test tests/pages-runtime.test.mjs",
    "test:pages:ui": "playwright test --config=playwright.pages.config.js",
    "deploy:worker": "npx wrangler deploy",
    "seo:check": "node scripts/publication.mjs",
    "seo:write": "node scripts/publication.mjs --write",
    "prerender": "node scripts/prerender.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "http-server": "^14.1.1"
  }
}
