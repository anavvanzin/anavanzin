# Cloudflare Workers static-asset headers.
# https://developers.cloudflare.com/workers/static-assets/headers/
# Applied to asset responses. Dynamic /_state (worker.js) sets its own
# Cache-Control; these rules do not rewrite that JSON endpoint.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# fetch_fonts.py regenerates woff2 in place under stable names, so the
# binaries are not immutable; one week plus revalidation matches /assets/*.
/fonts/*.woff2
  Cache-Control: public, max-age=604800, must-revalidate

# Versioned artwork (-800/-1672, -360/-720) and stable corpus files; a
# content edit can stay cached up to a week at the edge and in the browser.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

# The stylesheet keeps a stable URL and must be allowed to revalidate.
/fonts/fonts.css
  Cache-Control: public, max-age=3600, must-revalidate

# Vendored filenames are stable, but their contents can change on upgrades.
/vendor/*
  Cache-Control: public, max-age=604800, must-revalidate

# Vite fingerprints every file it emits (index-HASH.js/css), so the estudar
# bundles are immutable; a rebuild changes the name and the HTML reference.
/estudar/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep workers.dev preview URLs out of search indexes.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
