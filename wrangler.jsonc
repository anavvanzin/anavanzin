// Pages deployment configuration. Preview and production use separate MESAS KV.
// Preserve the existing production corpus binding without querying its data.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anavanzin",
  "pages_build_output_dir": "./.worker-assets",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "MESAS",
      "id": "f68b5eef312746c794e86c37be7bf7e1"
    }
  ],
  "env": {
    "production": {
      "services": [{ "binding": "ICONOCRACIA_WORK", "service": "anavanzin-kimi" }],
      "compatibility_date": "2026-10-04",
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "vars": {
        "NODE_VERSION": "22"
      },
      "kv_namespaces": [
        {
          "binding": "MESAS",
          "id": "f68b5eef312746c794e86c37be7bf7e1"
        }
      ],
      "d1_databases": [
        {
          "binding": "corpus",
          "database_name": "iconocracy-corpus",
          "database_id": "77c09df7-b510-48b3-8a39-94b39416aa2f"
        }
      ]
    },
    "preview": {
      // Shared read-only static work; MESAS remains isolated below.
      "services": [{ "binding": "ICONOCRACIA_WORK", "service": "anavanzin-kimi" }],
      "kv_namespaces": [
        {
          "binding": "MESAS",
          "id": "6ea9865c03d640e1846cabda3d2194ec"
        }
      ]
    }
  }
}
